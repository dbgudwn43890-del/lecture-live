# 실제 키는 .env.local에만 넣고 커밋하지 않습니다.
# 강의실 실시간 받아쓰기는 Deepgram Nova-3를 사용합니다. 장기 키는 서버에만 둡니다.
DEEPGRAM_API_KEY=
# 실시간 녹음 중계 주소. Next는 .env.stt-relay.local을 자동으로 읽지 않으므로
# 로컬 .env.local에도 넣습니다. 기존 운영 중계를 사용할 때는 localhost:3000과
# 운영과 동일한 Supabase 티켓 저장소를 사용합니다.
# 변경 후 개발 서버를 재시작하고 브라우저를 새로고침해야 CSP에도 반영됩니다.
STT_RELAY_URL=wss://lecue-stt-relay.lecue-app.workers.dev/v1/listen
# Worker -> /api/stt/relay 콜백 서버가 검증하는 공유 비밀 키입니다.
# 운영 Worker와 운영 앱에는 동일한 값이 필요합니다. 위 운영 중계에 연결하는
# 로컬 티켓 발급에는 필요하지 않으며 NEXT_PUBLIC_로 노출하지 않습니다.
STT_RELAY_SECRET=
OPENAI_API_KEY=
# 운영 환경에서 /stt-lab 실험 도구를 열 수 있는 Supabase user id 목록(쉼표 구분). 비우면 아무도 못 씁니다.
STT_LAB_USER_IDS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase backend-only secret key. 브라우저에 노출하거나 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
# 비우면 createAdminClient()가 null을 돌려주고, 같은 강의실의 이전 수업·강의 자료
# 검색과 강의 자료 맥락 연결이 조용히 꺼집니다. 오류는 나지 않으니 로컬에서도 채워 둡니다.
SUPABASE_SECRET_KEY=
# 마이그레이션 실행 전용 Postgres 접속 문자열입니다. 앱 런타임은 쓰지 않습니다.
# Dashboard → Settings → Database → Connection string → URI 값을 그대로 넣습니다.
SUPABASE_DB_URL=
# Paddle 서버 값입니다. sandbox 검증 후 production 값으로 각각 교체합니다.
PADDLE_ENVIRONMENT=sandbox
BILLING_ENABLED=false
PADDLE_MONTHLY_V2_PRICE_ID=
PADDLE_SEMESTER_V2_PRICE_ID=
PADDLE_ANNUAL_V2_PRICE_ID=
PADDLE_TOPUP_V2_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_MONTHLY_NO_TRIAL_PRICE_ID=
PADDLE_TERM_PRICE_ID=
PADDLE_SEMESTER_PRICE_ID=
# 브라우저에는 Paddle이 발급한 공개 Client-side token만 노출합니다.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# 녹음 파일 업로드(UPL-01~07)에 필요합니다. Deepgram이 받아쓰기를 끝내고 결과를
# 돌려보낼 이 서비스의 공개 주소입니다. 예: https://lecue.app
# 로컬에서 시험하려면 터널 주소를 넣습니다. 비우면 업로드가 503을 돌려줍니다.
SITE_URL=
# 위 콜백 주소에 붙는 서명 키입니다. Deepgram은 로그인 쿠키를 들고 오지 않으므로,
# 이 값으로 만든 HMAC이 콜백이 진짜인지 판별하는 유일한 근거입니다.
# `openssl rand -hex 32` 같은 임의 값으로 채우고 절대 공개하지 않습니다.
LECTURE_AUDIO_CALLBACK_SECRET=
