# 실제 키는 .env.local에만 넣고 커밋하지 않습니다.
# 강의실 실시간 받아쓰기 엔진. whisper(기본, Cloudflare Workers AI, 저렴) | deepgram(비쌈, 되돌릴 때만 사용).
STT_PROVIDER=whisper
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# 강의실 받아쓰기(STT_PROVIDER=whisper 기본값)와 /stt-lab 실험 모두 이 값을 씁니다. 브라우저에 노출하지 않습니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase backend-only secret key. 브라우저에 노출하거나 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
SUPABASE_SECRET_KEY=
# Paddle 서버 값입니다. sandbox 검증 후 production 값으로 각각 교체합니다.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_MONTHLY_NO_TRIAL_PRICE_ID=
PADDLE_TERM_PRICE_ID=
PADDLE_SEMESTER_PRICE_ID=
# 브라우저에는 Paddle이 발급한 공개 Client-side token만 노출합니다.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
